<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/window_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?android:attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="@color/text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/title_settings"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 服务器 -->
            <LinearLayout
                style="@style/SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cat_server" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/server_address"
                    app:boxStrokeColor="@color/brand_light"
                    app:hintTextColor="@color/brand_light">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etServer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnSaveServer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/save" />

                    <Button
                        android:id="@+id/btnHistory"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/server_history"
                        android:textColor="@color/brand_light" />

                    <Button
                        android:id="@+id/btnOpenAdmin"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/server_test"
                        android:textColor="@color/brand_light" />

                </LinearLayout>

            </LinearLayout>

            <!-- 显示与交互 -->
            <LinearLayout
                style="@style/SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cat_display" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchDesktop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/desktop_mode"
                    android:textColor="@color/text_primary" />

                <TextView
                    style="@style/TextHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/desktop_mode_desc" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/custom_ua"
                    app:boxStrokeColor="@color/brand_light"
                    app:hintTextColor="@color/brand_light">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textMultiLine"
                        android:maxLines="3"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnSaveUa"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/save_ua"
                    android:textColor="@color/brand_light" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchImmersive"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/immersive"
                    android:textColor="@color/text_primary" />

                <TextView
                    style="@style/TextHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/immersive_desc" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchKeepScreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/keep_screen_on"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAutoLandscape"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_landscape"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchFab"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/show_fab"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchPullRefresh"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pull_refresh"
                    android:textColor="@color/text_primary" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchLongPress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/long_press_save"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

            <!-- 背景图 -->
            <LinearLayout
                style="@style/SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cat_background" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchBg"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bg_enable"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnPickBg"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bg_pick_local"
                    android:textColor="@color/brand_light"
                    app:strokeColor="@color/brand_light" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/bg_online_url"
                    app:boxStrokeColor="@color/brand_light"
                    app:hintTextColor="@color/brand_light">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etBgUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnApplyBgUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/save" />

                <TextView
                    style="@style/TextBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/bg_scope"
                    android:textSize="13sp" />

                <Spinner
                    android:id="@+id/spinnerScope"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp" />

                <TextView
                    style="@style/TextBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/bg_dim"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderDim"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="5.0"
                    android:value="45.0"
                    android:valueFrom="0.0"
                    android:valueTo="85.0" />

                <TextView
                    style="@style/TextBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bg_blur"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderBlur"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1.0"
                    android:value="0.0"
                    android:valueFrom="0.0"
                    android:valueTo="20.0" />

                <Button
                    android:id="@+id/btnClearBg"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/bg_clear"
                    android:textColor="@color/text_secondary" />

                <TextView
                    style="@style/TextHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/bg_tip" />

            </LinearLayout>

            <!-- 高级 -->
            <LinearLayout
                style="@style/SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cat_advanced" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchAdblock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/adblock_enable"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnAdblockRules"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/adblock_rules"
                    android:textColor="@color/brand_light"
                    app:strokeColor="@color/brand_light" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchIgnoreSsl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ignore_ssl"
                    android:textColor="@color/text_primary" />

                <TextView
                    style="@style/TextHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/ignore_ssl_desc" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMediaHook"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/inject_media_hook"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/btnClearCache"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/clear_cache"
                    android:textColor="@color/brand_light"
                    app:strokeColor="@color/brand_light" />

            </LinearLayout>

            <!-- 关于 -->
            <LinearLayout
                style="@style/SettingsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/TextTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/cat_about" />

                <TextView
                    android:id="@+id/tvVersion"
                    style="@style/TextBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/tvSite"
                    style="@style/TextBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnOpenBrowser"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_open_web"
                    android:textColor="@color/brand_light" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
